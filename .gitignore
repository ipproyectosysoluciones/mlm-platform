# ===========================================
# MLM Platform - .gitignore
# ===========================================

# ===========================================
# Dependencies
# ===========================================
node_modules/
.pnpm-store/

# ===========================================
# Build outputs
# ===========================================
dist/
build/

# ===========================================
# Environment (CRITICAL - NEVER commit)
# ===========================================
.env
.env.local
.env.*.local
.env.production
.env.production.local
.env.azure
.env.azure.local

# ===========================================
# Terraform (CRITICAL - NEVER commit secrets)
# ===========================================
infrastructure/terraform/terraform.tfvars
infrastructure/terraform/*.tfstate
infrastructure/terraform/*.tfstate.backup
infrastructure/terraform/.terraform/
infrastructure/terraform/.terraform.lock.hcl

# ===========================================
# Logs
# ===========================================
logs/
*.log
npm-debug.log*

# ===========================================
# OS files
# ===========================================
.DS_Store
Thumbs.db

# ===========================================
# IDE - User specific (keep .vscode/settings.json)
# ===========================================
.idea/
*.swp
*.swo

# ===========================================
# Test coverage
# ===========================================
coverage/
.nyc_output/

# ===========================================
# Docker
# ===========================================
.dockerignore

# ===========================================
# Playwright
# ===========================================
test-results/
playwright-report/
playwright/.cache/
frontend/test-screenshots/
frontend/e2e/screenshots/
frontend/e2e/debug-*.spec.ts

# ===========================================
# Temporary files
# ===========================================
tmp/
temp/
*.tmp

# ===========================================
# Database
# ===========================================
*.sqlite
*.db

# ===========================================
# Credentials
# ===========================================
credentials.json
secrets/

# ===========================================
# TypeScript cache
# ===========================================
*.tsbuildinfo

# ===========================================
# Project specific - Internal/AI tools (not needed for dev)
# ===========================================
.atl/                               # AI agent skill registry (internal)
.sdd/*/apply-progress/              # SDD apply progress (internal)
openspec/

# ===========================================
# API Testing files (Postman collections - use docs/API.md instead)
# ===========================================
postman/

# ===========================================
# Vercel
# ===========================================
.vercel/

# ===========================================
# Deploy scripts (configure on server, not in repo)
# ===========================================
deploy.sh
deploy.prod.sh
# Allow infrastructure deploy script (infrastructure-as-code, versioned)
!infrastructure/scripts/deploy.sh

# ===========================================
# Sentry
# ===========================================
.sentryclirc

# ===========================================
# Misc
# ===========================================
*.tgz
*.tar.gz

# ===========================================
# Generated (swagger export)
# ===========================================
backend/swagger.json

# ===========================================
# AI Prompts & Knowledge Base
# Files live at bot/src/prompt_kb/ and are baked into the Docker image.
# No longer gitignored — must be tracked to be included in the Docker build context.
# ===========================================
# /prompt_kb/  ← removed: prompt_kb is now baked into the bot Docker image

/.vscodeioredis
