# ============================================
# Nexo Real — Monitoring Configuration
# ============================================
# Copy this to .env.monitoring and fill in your values
# chmod 600 .env.monitoring (restrict access)
# THIS FILE IS IN .gitignore — never commit real values

# ── Telegram ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Email (Brevo) — disabled, Telegram only ────────────────────────
# BREVO_API_KEY=
# ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM=noreply@nexoreal.xyz

# ── Thresholds ────────────────────────────────────────────────────
DISK_WARN_PERCENT=80
DISK_CRIT_PERCENT=90
MEMORY_WARN_PERCENT=85
HEALTH_CHECK_TIMEOUT=10
